{
  "buildCommand": "echo 'No build needed'",
  "framework": null,
  "installCommand": "npm install",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/sw\\.js",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(index\\.html|demo-data\\.js|sw\\.js|manifest\\.webmanifest|icons/[\\w.-]+)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "status": 404
    }
  ]
}
