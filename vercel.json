{
  "buildCommand": "echo 'No build needed'",
  "framework": null,
  "installCommand": "npm install",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(index\\.html|demo-data\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "status": 404
    }
  ]
}
